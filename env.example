# =============================================================================
# WICHTIG: Aufloesungsreihenfolge ist Datenbank First - Env - Default.
# App-Konfiguration (LLM, Embedding, Retriever, Storage, STT, API-Keys) wird im
# Einstellungen-Panel (UI / Settings-DB) gepflegt. Sobald ein Setting einmal in
# der DB existiert, gewinnt der DB-Wert dauerhaft gegen diese env-Datei - ein
# Aendern hier hat dann keinen Effekt mehr, bis der Wert ueber das UI geaendert
# wird. Ausnahmen (ENV_ONLY, immer env): Qdrant, OCR, Datenveraenderung unten.
# Diese Datei ist Vorlage fuer .env und dient docker compose als Variablenquelle.
# =============================================================================

# Qdrant (connect to a running Qdrant server; in docker-compose default: "qdrant")
QDRANT_HOST=qdrant
QDRANT_PORT=6333
# QDRANT_API_KEY=secret  # only for secured remote Qdrant

# OCR-Engine fuer PDFs (Docling): tesseract (Default, CLI-Binary), rapidocr (ONNX,
# im Standard-Installationsumfang enthalten), ocrmac (nur macOS), off (kein OCR).
# OCR_ENGINE=tesseract
# Sprachcodes (Komma-getrennt); Bedeutung haengt an der Engine: Tesseract liest
# ISO-639-2 (deu, eng; braucht installierte Sprachpakete), RapidOCR PP-OCR-Codes
# (de; nur der erste Wert wird genutzt), ocrmac Locales (de-DE).
# OCR_LANGUAGES=deu,eng
# Pfad zur tesseract-Binary, wenn sie nicht im PATH liegt (z. B. Windows):
# OCR_TESSERACT_CMD="C:/Program Files (x86)/Tesseract-OCR/tesseract.exe"

# Datenbank (Postgres). In docker-compose wird DATABASE_URL aus diesen Werten gebaut;
# fuer den Betrieb ein eigenes Passwort setzen.
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
# Nur fuer die App ausserhalb von Docker (z. B. run_mac.py / lokale Entwicklung):
# DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag
# Ohne DATABASE_URL nutzt die App eine lokale SQLite-Datei, nur fuer Entwicklung und Tests.
POSTGRES_PORT=5432

# Schluessel, mit dem Zugangsdaten in der Datenbank verschluesselt werden (API-Keys, Quellen-Zugaenge).
# Erzeugen: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leer: die App legt beim ersten Start eine Schluesseldatei im Datenverzeichnis an (schuetzt nur vor einem
# Datenbank-Dump, nicht vor Zugriff auf das ganze Datenverzeichnis). Nie verlieren: ohne ihn sind die Werte weg.
ENCRYPTION_KEY=

# Tool-Worker (fuehrt Pandas-Code isoliert aus). Pflicht fuer docker compose; Beispiel: openssl rand -hex 32
TOOL_WORKER_TOKEN=

# =============================================================================
# Optionale Referenz — nur setzen, wenn der Default nicht passt (alles nur env).
# =============================================================================

# Datenverzeichnisse (Structured Data + Uploads / gespeicherte Analysen).
# In Docker unnoetig (Volume /app/data); ausserhalb Default ./data bzw. ./data/summaries:
# DATA_DIR=./data
# SUMMARIES_DIR=./data/summaries

# Rechengeraet fuer Embedding/Reranking/Docling erzwingen. Default: automatisch (cuda > mps > cpu):
# RAG_DEVICE=cpu

# Log-Ausführlichkeit der App (INFO | DEBUG | WARNING). Default INFO: eine Zeile je Chat, Warnungen, Fehler.
# DEBUG zeigt den vollen Ablauf (Tools, Retrieval, Einlesen je Datei), nie Nutzerinhalte.
# LOG_LEVEL=INFO

# Session-Cookie nur an HTTPS-Verbindungen schicken. Nur in einer HTTPS-Bereitstellung aktivieren:
# SESSION_COOKIE_SECURE=true

# Passwort des Seeded-Kontos 'admin' bei erster Inbetriebnahme (leerer Nutzerbestand). Default 'admin':
# ADMIN_PASSWORD=geheimespasswort